COMPOSE_PROJECT_NAME=evdp
# Release metadata. Production deployments should set these from the Git tag,
# commit SHA, and UTC build timestamp used for the deployed images.
EVDP_RELEASE_VERSION=dev
EVDP_GIT_SHA=unknown
EVDP_BUILD_TIME=unknown
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=80
POSTGRES_DB=evdp
POSTGRES_USER=evdp
POSTGRES_PASSWORD=evdp_local_postgres_password
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://evdp:evdp_local_postgres_password@postgres:5432/evdp
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
REDIS_PASSWORD=evdp_local_redis_password
REDIS_URL=redis://:evdp_local_redis_password@redis:6379/0
# Only set this when the API is behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
RABBITMQ_DEFAULT_USER=evdp
RABBITMQ_DEFAULT_PASS=evdp_local_rabbitmq_password
RABBITMQ_URL=amqp://evdp:evdp_local_rabbitmq_password@rabbitmq:5672
# Object storage: MinIO (local default) or Alibaba Cloud OSS (S3-compatible API).
# OSS 官方 S3 兼容 Endpoint 格式: https://s3.oss-{region}.aliyuncs.com
# 若服务器是阿里云 ECS 且与 Bucket 同地域, 改用内网 Endpoint (流量免费):
#   https://s3.oss-{region}-internal.aliyuncs.com
MINIO_BUCKET=evdp-videos
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=evdp_local_minio
MINIO_SECRET_KEY=evdp_local_minio_password
# For Alibaba Cloud OSS set MINIO_REGION to the bucket region id, e.g. cn-beijing,
# and MINIO_FORCE_PATH_STYLE=false (OSS S3-compatible API uses virtual-hosted style).
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
SUBMISSION_OBJECT_RETENTION_DAYS=180
SUBMISSION_STORAGE_RECONCILE_INTERVAL_MS=30000
QWEN_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_QUALITY_CONCURRENCY=3
EVDP_AUTO_RECLAIM_WORKER_TIMEOUTS=true
AI_QUALITY_MODEL_TIMEOUT_MS=600000
MEDIA_WORKER_TASK_TIMEOUT_MS=600000
VIDEO_QUALITY_PROMPT_PATH=/quality/prompts/qwen-video-ai-quality-framework-v2/manifest.json
VIDEO_QUALITY_INITIAL_MODEL=qwen3.7-plus
VIDEO_QUALITY_REVIEW_MODEL=qwen3.7-flash
# 任务要求 AI 规范化使用的文本模型（复用 QWEN_API_KEY / QWEN_BASE_URL）
TASK_REQUIREMENT_NORMALIZER_MODEL=qwen3.7-plus
TASK_REQUIREMENT_NORMALIZER_TIMEOUT_MS=120000
QUALITY_LAB_HOST=127.0.0.1
QUALITY_LAB_PORT=4010
QUALITY_LAB_MAX_UPLOAD_BYTES=1073741824
QUALITY_LAB_MODEL_TIMEOUT_MS=600000
QUALITY_LAB_HISTORY_PATH=/data/quality-lab/jobs.json
QUALITY_LAB_PROMPT_STATE_PATH=/data/quality-lab/prompt.json
QUALITY_LAB_HISTORY_RETENTION_DAYS=30
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
BACKEND_INTERNAL_URL=http://api:4000/api/v1
